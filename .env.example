# Скопируйте в .env и при необходимости измените значения.

APP_ENV=local
LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_USER=ai_coach
POSTGRES_PASSWORD=ai_coach_dev
POSTGRES_DB=ai_coach

# Для приложения внутри compose используется имя сервиса db.
# Для запуска без Docker замените host на localhost.
DATABASE_URL=postgresql+pg8000://ai_coach:ai_coach_dev@db:5432/ai_coach
